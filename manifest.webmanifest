{
  "name": "Warqati",
  "short_name": "Warqati",
  "description": "Pen and paper for your ideas - ورقة وقلم لأفكارك",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e9e4d8",
  "theme_color": "#e9e4d8",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/x-opml": [
          ".opml"
        ]
      }
    }
  ]
}
